# Copy to .env and fill in. Never commit .env — it is gitignored and the
# pre-commit hook runs gitleaks over staged changes.

# --- Core ---
NODE_ENV=development
# Reported by both /health endpoints and shown on /status. A version that never
# changes is a version nobody can use to tell two deploys apart.
APP_VERSION=0.1.0

# --- Database (Postgres) ---
# Published on 5437 to avoid clashing with a host PostgreSQL on 5432 and with the
# other portfolio stacks on 5433/5434/5435/5436.
DATABASE_URL=postgresql://kan:kan@localhost:5437/kan?schema=public
# Direct (unpooled) connection, used only by `prisma migrate`. Locally this is the
# same value; behind a transaction-mode pooler it is the provider's direct URL,
# because migrations cannot run through one.
DIRECT_DATABASE_URL=postgresql://kan:kan@localhost:5437/kan?schema=public

# --- Redis ---
# Three jobs: the Socket.io adapter's pub/sub (which is what lets two realtime
# processes serve one board), the presence roster, and rate limiting.
REDIS_URL=redis://localhost:6384

# --- API service (REST) ---
API_PORT=4000
# Server-to-server base URL, used by the web app's server components.
API_BASE_URL=http://localhost:4000

# --- Realtime service (WebSocket) ---
# A separate process from the API on purpose: the board's write path lives in
# services/board-ops and both processes call it, so the socket server is not a
# thin relay in front of the API and a drag costs one hop rather than two.
REALTIME_PORT=4100
# Server-to-server, for the /status page's health probe.
REALTIME_BASE_URL=http://localhost:4100
# A second gateway replica, when one is running. The gateway is the process that
# scales horizontally: several replicas share one board through the Socket.io
# Redis adapter. `docker compose --profile app up` starts one on 4101, and
# scripts/integration.sh starts one to prove that a move made on 4100 reaches a
# client on 4101 -- with a single process that assertion is vacuous, because both
# clients would sit on the same in-memory adapter. Leave it as is for a
# single-replica setup; nothing breaks if that replica is not running.
REALTIME_BASE_URL_2=http://localhost:4101
# Browser-visible socket URL. Baked into the client bundle at build time.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible API URL. Baked at build time by infra/Dockerfile.web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth ---
# Shared by web (Auth.js session + service-token minting), api (token
# verification) and realtime (socket handshake verification). All three verify
# the same HS256 signature, which is what lets the socket handshake reuse the
# token the REST client already carries. Must be >= 16 chars.
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Ordering / concurrency ---
# How many times a card move re-generates its fractional index after Postgres
# rejects it with a unique violation on (list_id, position).
#
# A collision means two clients dropped a card into the same gap in the same
# millisecond and the jitter happened to agree. That is rare, and each retry
# re-jitters, so the probability of N consecutive collisions falls off a cliff.
# The ceiling exists so a genuinely stuck move fails with a named error instead
# of spinning: an unbounded retry loop under contention is an outage, not a fix.
MOVE_RETRY_ATTEMPTS=5

# --- Presence ---
# A client refreshes its roster entry every PRESENCE_HEARTBEAT_SECONDS; the entry
# expires PRESENCE_TTL_SECONDS after the last refresh. The TTL is deliberately
# more than twice the heartbeat: at exactly 2x, one dropped packet evicts a person
# who is still looking at the board, and a presence bar that flickers is worse
# than one that is a few seconds stale.
PRESENCE_HEARTBEAT_SECONDS=10
PRESENCE_TTL_SECONDS=25

# --- Socket limits ---
# Largest accepted socket frame, in bytes (64 KB). A card's title, description and
# move intent are all well under 1 KB; the ceiling stops a single client from
# pinning a gateway with a payload nobody asked for.
SOCKET_MAX_PAYLOAD_BYTES=65536
# Events per minute per socket. A fast drag emits one move; a person dragging
# continuously for a minute emits maybe 60. 240 leaves room for that and for the
# presence heartbeat without leaving room for a loop.
SOCKET_EVENT_RATE_LIMIT=240

# --- Activity feed ---
# Rows per page in the board's activity history.
ACTIVITY_PAGE_SIZE=25

# --- Rate limits (requests per minute, per client IP) ---
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
